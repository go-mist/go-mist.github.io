---
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const databases = [
	{ name: 'PostgreSQL', file: 'postgresql.svg', id: 'postgresql' },
	{ name: 'MySQL', file: 'mysql.svg', id: 'mysql' },
	{ name: 'MariaDB', file: 'mariadb.svg', id: 'mariadb' },
	{ name: 'SQLite', file: 'sqlite.svg', id: 'sqlite' },
	{ name: 'Oracle', file: 'oracle.svg', id: 'oracle' },
	{ name: 'SQL Server', file: 'sqlserver.svg', id: 'sql-server' },
	{ name: '达梦', file: 'dameng.svg', id: 'dameng' },
	{ name: '瀚高', file: 'highgo.svg', id: 'highgo' },
	{ name: '人大金仓', file: 'kingbase.webp', id: 'kingbasees' },
];
---

<h2 id="databases">Supported databases</h2>
<div class="db-grid">
	{
		databases.map((db) => (
			<a class="db-card" href={`${base}dialects/#${db.id}`}>
				<img src={`${base}db/${db.file}`} alt="" width="28" height="28" />
				<span>{db.name}</span>
			</a>
		))
	}
</div>
